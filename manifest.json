{
  "manifest_version": 3,
  "name": "Korean Hanja & Loanword Annotator",
  "version": "1.1.56.28",
  "description": "Dictionary-based Korean Hanja and loanword annotations entirely in your browser, with optional model review.",
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "storage",
    "contextMenus",
    "offscreen",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Korean Hanja & Loanword Annotator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "paragraph-plan.js",
        "text-chunks.js",
        "hanja-reading-check.js",
        "hanja-reading-data.js",
        "repair-validation-core.js",
        "manual-answer-format.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
